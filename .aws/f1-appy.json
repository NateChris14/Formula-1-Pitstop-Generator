{
    "family": "f1-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
      {
        "name": "f1-container",
        "image": "REPLACE_ME",  
        "essential": true,
        "portMappings": [
          {
            "containerPort": 5000,
            "hostPort": 5000,
            "protocol": "tcp"
          }
        ]
      }
    ],
    "executionRoleArn": "arn:aws:iam::<your-account-id>:role/ecsTaskExecutionRole"
  }
  