{
    "family": "f1-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
      {
        "name": "f1-prediction",
        "image": "136904910983.dkr.ecr.eu-north-1.amazonaws.com/f1-prediction:latest",  
        "essential": true,
        "portMappings": [
          {
            "containerPort": 5000,
            "hostPort": 5000,
            "protocol": "tcp"
          }
        ]
      }
    ],
    "executionRoleArn": "arn:aws:iam::136904910983:role/ecsTaskExecutionRole"
  }
  