{
  "family": "f1-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::020759835805:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "f1-container",
      "image": "020759835805.dkr.ecr.eu-north-1.amazonaws.com/f1-prediction:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "FLASK_ENV", "value": "production" },
        { "name": "PORT", "value": "80" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/f1-task",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
